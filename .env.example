# ── Variables Railway (onglet Variables) — Boss 09/10 ────────────────────
# Reranker CrossEncoder ms-marco (voir reranker.py)
RERANK_ENABLED=1
# Seuil de pertinence en logits : sous ce score, PAS de réponse devinée.
# Calibré sur les fiches réelles + captures 07-09/10.
RERANK_THRESHOLD=-3.0
# Cache du modèle (~90 Mo). Monter le volume Railway sur /app/cache.
HF_HOME=/app/cache
TRANSFORMERS_CACHE=/app/cache
